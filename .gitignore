# Python 바이트코드 / 빌드 산출물
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 가상환경 (conda env는 프로젝트 밖에 있어 해당 없음)
.venv/
venv/
env/

# 환경변수 / 시크릿 (DB 비밀번호 등)
.env
.env.*
!.env.example

# 테스트 / 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE (settings.json에 머신별 절대경로가 있어 제외)
.vscode/
.idea/

# macOS
.DS_Store
