# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=blog_db

# --- Connection Pool ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_RECYCLE=300

# 실행되는 SQL을 로그로 출력 (개발 중에만 true 권장)
DB_ECHO=false
